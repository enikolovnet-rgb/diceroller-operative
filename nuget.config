<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="local" value="%USERPROFILE%/local-nuget" />
    <add key="github" value="https://nuget.pkg.github.com/enikolovnet-rgb/index.json" />
  </packageSources>

  <!-- GitHub Packages needs a token; CI enables this source and supplies credentials. Locally, packages come from ~/local-nuget. -->
  <disabledPackageSources>
    <add key="github" value="true" />
  </disabledPackageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local">
      <package pattern="DiceRoller.BuildingBlocks.*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="DiceRoller.BuildingBlocks.*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
